  /* operating-conditions */
  operating_conditions(ss_0p81v_0p81v_m40c) {
    process      : 1;
    temperature  : -40;
    voltage      : 0.81;
    tree_type    : balanced_tree;
  }
  default_operating_conditions : ss_0p81v_0p81v_m40c;

  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(rf2_32x128_wm1) {
    area : 8780.511900;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    /* Peak current of all modes. */
    peak_current : 24.993810;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 22.641791;
    /* leakage current in retention mode (RET1N=0) */
    retention_current : 0.0001886;
    memory() {
      type : ram;
      address_width : 5;
      word_width : 128;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
