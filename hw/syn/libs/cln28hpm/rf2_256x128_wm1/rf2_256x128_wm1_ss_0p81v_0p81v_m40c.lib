    fanout_length(1,500);
  }

  cell(rf2_256x128_wm1) {
    area : 21325.878300;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    /* Peak current of all modes. */
    peak_current : 60.163727;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 55.810453;
    /* leakage current in retention mode (RET1N=0) */
    retention_current : 0.001483;
    memory() {
      type : ram;
      address_width : 8;
      word_width : 128;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
