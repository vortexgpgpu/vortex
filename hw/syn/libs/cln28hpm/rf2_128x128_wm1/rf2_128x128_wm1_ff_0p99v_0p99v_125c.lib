  /* wire-loads */
  wire_load("sample") {
    resistance   : 1.6e-05;
    capacitance  : 0.0002;
    area         : 1.7;
    slope        : 500;
    fanout_length(1,500);
  }

  cell(rf2_128x128_wm1) {
    area : 14157.097500;
    dont_use : true;
    dont_touch : true;
    interface_timing : true;
    is_memory_cell : true;
    /* Peak current of all modes. */
    peak_current : 109.474013;
    /* Peak current when entering or exiting the power modes. */
    inrush_current : 100.181331;
    /* leakage current in retention mode (RET1N=0) */
    retention_current : 1.21731;
    memory() {
      type : ram;
      address_width : 7;
      word_width : 128;
    }
    pg_pin(VDDCE) {
      voltage_name : VDDCE;
      pg_type : backup_power;
      direction : inout;
    }
    pg_pin(VDDPE) {
      voltage_name : VDDPE;
      pg_type : primary_power;
