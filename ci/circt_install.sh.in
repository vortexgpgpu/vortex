#
# CIRCT install: the SystemVerilog frontend of every synthesis flow
# (circt-verilog, circt-opt, firtool) and the compiler foldsim builds on.
#
# Builds Vortex's CIRCT fork (LLVM, MLIR and CIRCT in one build) and installs
# it into $TOOLDIR/circt: tools, libraries, headers and CMake packages, which
# ci/foldsim_install.sh builds against. This script is the *producer* of the
# circt prebuilt: build here (once per OSVERSION, in that OS's container),
# then `ci/toolchain_prebuilt.sh --circt` packages the three tools and
# `ci/toolchain_install.sh --circt` fetches them. Most users install the
# prebuilt and never run this script.
#
# Release, assertions off, libstdc++ linked statically, no zlib/zstd: the
# tools run on any machine of the OSVERSION. Needs git, cmake >= 3.20, ninja,
# a C++17 compiler and python3; installs nothing system-wide.
#
# Idempotent: re-running rebuilds only what changed.

# exit when any command fails
set -e

TOOLDIR=${TOOLDIR:=@TOOLDIR@}

CIRCT_REPO=${CIRCT_REPO:=https://github.com/vortexgpgpu/circt.git}
CIRCT_REV=${CIRCT_REV:=vortex_3.x}

CIRCT_SRC=${CIRCT_SRC:=$TOOLDIR/circt-src}
CIRCT_PREFIX=${CIRCT_PREFIX:=$TOOLDIR/circt}
CIRCT_BUILD=$CIRCT_SRC/build
JOBS=${JOBS:=$(nproc)}

# ----------------------------------------------------------------------
# 1. Fetch: LLVM is a submodule pinned by the CIRCT revision.
# ----------------------------------------------------------------------
# CIRCT_REV is a branch, taken at its tip on origin, or a tag or a commit: the
# checkout is detached either way, so a re-run never stays on a stale local
# branch.
if [ ! -d "$CIRCT_SRC/.git" ]; then
    git clone "$CIRCT_REPO" "$CIRCT_SRC"
fi
git -C "$CIRCT_SRC" fetch --force --tags origin
if git -C "$CIRCT_SRC" rev-parse -q --verify "refs/remotes/origin/$CIRCT_REV^{commit}" >/dev/null; then
    git -C "$CIRCT_SRC" checkout --detach "origin/$CIRCT_REV"
else
    git -C "$CIRCT_SRC" checkout --detach "$CIRCT_REV^{commit}"
fi
git -C "$CIRCT_SRC" submodule update --init --depth 1 llvm

# ----------------------------------------------------------------------
# 2. Configure and build
# ----------------------------------------------------------------------
cmake -G Ninja -S "$CIRCT_SRC/llvm/llvm" -B "$CIRCT_BUILD" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$CIRCT_PREFIX" \
    -DLLVM_ENABLE_PROJECTS=mlir \
    -DLLVM_EXTERNAL_PROJECTS=circt \
    -DLLVM_EXTERNAL_CIRCT_SOURCE_DIR="$CIRCT_SRC" \
    -DLLVM_TARGETS_TO_BUILD=host \
    -DLLVM_ENABLE_ASSERTIONS=OFF \
    -DLLVM_STATIC_LINK_CXX_STDLIB=ON \
    -DLLVM_ENABLE_ZLIB=OFF \
    -DLLVM_ENABLE_ZSTD=OFF \
    -DLLVM_ENABLE_LIBXML2=OFF \
    -DLLVM_INSTALL_UTILS=ON \
    -DCIRCT_SLANG_FRONTEND_ENABLED=ON \
    -DCIRCT_SLANG_BUILD_FROM_SOURCE=ON
ninja -C "$CIRCT_BUILD" -j "$JOBS" circt-verilog circt-opt firtool
ninja -C "$CIRCT_BUILD" -j "$JOBS" install

# ----------------------------------------------------------------------
# 3. Check
# ----------------------------------------------------------------------
"$CIRCT_PREFIX/bin/circt-verilog" --version | head -1
echo "circt installed in $CIRCT_PREFIX"
