# exit when any command fails
set -e

TOOLDIR=${TOOLDIR:=@TOOLDIR@}
OSVERSION=${OSVERSION:=@OSVERSION@}

riscv32()
{
    echo "prebuilt riscv32-gnu-toolchain..."
    tar -C $TOOLDIR -cvjf riscv32-gnu-toolchain.tar.bz2 riscv32-gnu-toolchain
    split -b 50M riscv32-gnu-toolchain.tar.bz2 "riscv32-gnu-toolchain.tar.bz2.part"
    mkdir -p ./riscv32-gnu-toolchain/$OSVERSION
    mv riscv32-gnu-toolchain.tar.bz2.part* ./riscv32-gnu-toolchain/$OSVERSION
    rm riscv32-gnu-toolchain.tar.bz2
}

riscv64()
{
    echo "prebuilt riscv64-gnu-toolchain..."
    tar -C $TOOLDIR -cvjf riscv64-gnu-toolchain.tar.bz2 riscv64-gnu-toolchain
    split -b 50M riscv64-gnu-toolchain.tar.bz2 "riscv64-gnu-toolchain.tar.bz2.part"
    mkdir -p ./riscv64-gnu-toolchain/$OSVERSION
    mv riscv64-gnu-toolchain.tar.bz2.part* ./riscv64-gnu-toolchain/$OSVERSION
    rm riscv64-gnu-toolchain.tar.bz2
}

llvm()
{
    echo "prebuilt llvm-vortex..."
    tar -C $TOOLDIR -cvjf llvm-vortex.tar.bz2 llvm-vortex
    split -b 50M llvm-vortex.tar.bz2 "llvm-vortex.tar.bz2.part"
    mkdir -p ./llvm-vortex/$OSVERSION
    mv llvm-vortex.tar.bz2.part* ./llvm-vortex/$OSVERSION
    rm llvm-vortex.tar.bz2
}

libcrt32()
{
    echo "prebuilt libcrt32..."
    tar -C $TOOLDIR -cvjf libcrt32.tar.bz2 libcrt32
    mkdir -p ./libcrt32
    mv libcrt32.tar.bz2 ./libcrt32
}

libcrt64()
{
    echo "prebuilt libcrt64..."
    tar -C $TOOLDIR -cvjf libcrt64.tar.bz2 libcrt64
    mkdir -p ./libcrt64
    mv libcrt64.tar.bz2 ./libcrt64
}

libc32()
{
    echo "prebuilt libc32..."
    tar -C $TOOLDIR -cvjf libc32.tar.bz2 libc32
    mkdir -p ./libc32
    mv libc32.tar.bz2 ./libc32
}

libc64()
{
    echo "prebuilt libc64..."
    tar -C $TOOLDIR -cvjf libc64.tar.bz2 libc64
    mkdir -p ./libc64
    mv libc64.tar.bz2 ./libc64
}

pocl()
{
    echo "prebuilt pocl..."
    tar -C $TOOLDIR -cvjf pocl.tar.bz2 pocl
    mkdir -p ./pocl/$OSVERSION
    mv pocl.tar.bz2 ./pocl/$OSVERSION
}

chipstar()
{
    echo "prebuilt chipstar..."
    tar -C $TOOLDIR -cvjf chipstar.tar.bz2 chipstar
    mkdir -p ./chipstar/$OSVERSION
    mv chipstar.tar.bz2 ./chipstar/$OSVERSION
}

# Mesa with the vortexpipe Gallium driver — built by ci/mesa_install.sh
# into $TOOLDIR/mesa-vortex. ~9 MB compressed, so no split needed.
# Relocatability invariant: ci/mesa_install.sh rewrites the lavapipe ICD
# manifest's library_path to be relative to the manifest, so this tarball
# unpacks and runs under any $TOOLDIR. Re-run ci/mesa_install.sh before
# packaging if the tree was produced before that step existed (otherwise
# the baked absolute path makes vkCreateInstance fail with -9 on relocate).
mesa()
{
    echo "prebuilt mesa-vortex..."
    tar -C $TOOLDIR -cvjf mesa-vortex.tar.bz2 mesa-vortex
    mkdir -p ./mesa-vortex/$OSVERSION
    mv mesa-vortex.tar.bz2 ./mesa-vortex/$OSVERSION
}

verilator()
{
    echo "prebuilt verilator..."
    tar -C $TOOLDIR -cvjf verilator.tar.bz2 verilator
    split -b 50M verilator.tar.bz2 "verilator.tar.bz2.part"
    mkdir -p ./verilator/$OSVERSION
    mv verilator.tar.bz2.part* ./verilator/$OSVERSION
}

sv2v()
{
    echo "prebuilt sv2v..."
    tar -C $TOOLDIR -cvjf sv2v.tar.bz2 sv2v
    mkdir -p ./sv2v/$OSVERSION
    mv sv2v.tar.bz2 ./sv2v/$OSVERSION
}

yosys()
{
    echo "prebuilt yosys..."
    tar -C $TOOLDIR -cvjf yosys.tar.bz2 yosys
    split -b 50M yosys.tar.bz2 "yosys.tar.bz2.part"
    mkdir -p ./yosys/$OSVERSION
    mv yosys.tar.bz2.part* ./yosys/$OSVERSION
    rm yosys.tar.bz2
}

sta()
{
    echo "prebuilt sta..."
    tar -C $TOOLDIR -cvjf sta.tar.bz2 sta
    mkdir -p ./sta/$OSVERSION
    mv sta.tar.bz2 ./sta/$OSVERSION
}

# gem5 — slim runtime tree at $TOOLDIR/gem5 produced by ci/gem5_install.sh:
# build/{X86,ARM}/gem5.opt (stripped) + configs/. Ships as a single ~20 MB
# bz2 (no split). The 12 GB source/build tree at $TOOLDIR/gem5-src is not
# packaged — it's build-time scaffolding.
gem5()
{
    echo "prebuilt gem5..."
    tar -C $TOOLDIR -cvjf gem5.tar.bz2 gem5
    mkdir -p ./gem5/$OSVERSION
    mv gem5.tar.bz2 ./gem5/$OSVERSION
}

# SST is intentionally NOT prebuilt — autoconf bakes the install $prefix
# into multiple absolute-path references (sstsimulator.conf path + the
# sst wrapper's locator for libexec/sstsim.x), so a tarball produced on
# one machine doesn't relocate cleanly to another. SST is built from
# source by ci/sst_install.sh, which now also runs an aggressive
# strip+prune pass that drops the install from ~2.9 GB to ~36 MB.

# FireSim: the checkout from vortexgpgpu/firesim plus the conda environment
# its build-setup produces. Only the environment is expensive -- it carries a
# JVM, sbt and Scala for Golden Gate elaboration and takes far longer to
# resolve than to download -- but it is shipped together with the sources so
# $TOOLDIR/firesim is self-contained, matching how pocl and mesa install.
#
# Relocatability invariant: a conda environment records its own prefix in
# every script shebang and in its package metadata, so a plain tar does NOT
# relocate. Packaging therefore goes through conda-pack, and the install side
# must run conda-unpack to rewrite those prefixes. Skipping either step
# produces an environment whose `conda activate` silently resolves to the
# packaging machine's path, and the first symptom is an unrelated compile
# error about a missing header.
#
# Excluded, and why: platforms/vitis/cl_vitis-* and sim/output are per-design
# build outputs -- note the narrower glob, since the sibling cl_firesim is the
# template the flow copies from and dropping it fails elaboration at the very
# last step -- sim/generated-src is rewritten on every elaboration, tags is a
# regenerable ctags index, .conda-lock-env is bootstrap scaffolding used only
# by build-setup.sh, and the f1/f2/vcu118/nitefury submodules are other FPGA
# platforms the Vitis flow never reads (1.4 GB between them).
#
# The environment is packed uncompressed (.tar) because the outer archive
# compresses it; nesting gzip inside bzip2 costs time and gains nothing.
firesim()
{
    echo "prebuilt firesim..."

    # conda-pack need not live inside the environment being packed -- and it
    # should not, since installing it there makes conda re-solve the whole
    # environment. Take it from $CONDA_PACK or $PATH.
    # `|| true` is load-bearing: under set -e a failing command substitution
    # in an assignment aborts the script, so without it the diagnostic below
    # never prints and the failure is silent.
    CONDA_PACK=${CONDA_PACK:-$(command -v conda-pack || true)}
    if [ ! -x "$CONDA_PACK" ]; then
        echo "error: conda-pack not found on \$PATH and \$CONDA_PACK unset." >&2
        echo "       Without it the environment cannot be relocated and the" >&2
        echo "       tarball is only valid on this machine. Install it into a" >&2
        echo "       throwaway prefix (NOT into .conda-env):" >&2
        echo "         pip install --target /some/dir conda-pack" >&2
        exit 1
    fi

    # A conda environment is identified by the prefix baked into its own
    # metadata, not by where it currently sits. Pass conda-pack any other
    # path and the prefix strings silently fail to match, producing a tarball
    # that unpacks to a broken environment. Recover the real prefix and refuse
    # to continue unless it resolves to the same place as $TOOLDIR/firesim.
    env_dir="$TOOLDIR/firesim/.conda-env"
    env_prefix=$(sed -n 's/^# cmd: .*--prefix \([^ ]*\).*/\1/p' \
                 "$env_dir/conda-meta/history" | head -1)
    if [ -z "$env_prefix" ]; then
        echo "error: cannot read the build prefix from $env_dir/conda-meta/history" >&2
        exit 1
    fi
    if [ "$(readlink -f "$env_prefix")" != "$(readlink -f "$env_dir")" ]; then
        echo "error: $env_dir was built as $env_prefix and does not resolve" >&2
        echo "       back to it, so packing it here would produce a tarball" >&2
        echo "       whose prefixes never get rewritten. Rebuild the" >&2
        echo "       environment in place with build-setup.sh. (Repacking an" >&2
        echo "       environment that came from a prebuilt and was relocated" >&2
        echo "       by conda-unpack lands here too -- pack from the machine" >&2
        echo "       that built it.)" >&2
        exit 1
    fi

    # conda-pack stages ~4 GB through a temp file; keep it off a small /tmp.
    # --ignore-missing-files is required because FireSim's build-setup.sh
    # pip-installs over conda-managed packages, leaving their dist-info
    # records clobbered; the libraries themselves are intact.
    mkdir -p ./firesim-tmp
    TMPDIR=$PWD/firesim-tmp "$CONDA_PACK" -p "$env_prefix" \
        -o firesim-conda-env.tar --format tar --ignore-missing-files --force
    rm -rf ./firesim-tmp

    rm -rf ./firesim-staging && mkdir -p ./firesim-staging/firesim
    tar -C "$TOOLDIR/firesim" -cf - \
        --exclude=.git \
        --exclude=.conda-env \
        --exclude=.conda-lock-env \
        --exclude=tags \
        --exclude='platforms/vitis/cl_vitis-*' \
        --exclude=platforms/f1 \
        --exclude=platforms/f2 \
        --exclude=platforms/xilinx_vcu118 \
        --exclude=platforms/rhsresearch_nitefury_ii \
        --exclude=sim/output \
        --exclude=sim/generated-src \
        . | tar -C ./firesim-staging/firesim -xf -
    mkdir -p ./firesim-staging/firesim/.conda-env
    mv firesim-conda-env.tar ./firesim-staging/firesim/.conda-env/
    tar -C ./firesim-staging -cjf firesim.tar.bz2 firesim
    split -b 50M firesim.tar.bz2 "firesim.tar.bz2.part"
    mkdir -p ./firesim/$OSVERSION
    # Clear the destination first. Re-packaging smaller content leaves the
    # tail parts of the previous run behind, and since the install side
    # concatenates every part it finds, those stale bytes corrupt the archive
    # after the point where the two runs diverge.
    rm -f ./firesim/$OSVERSION/firesim.tar.bz2.part*
    mv firesim.tar.bz2.part* ./firesim/$OSVERSION
    rm -rf firesim.tar.bz2 ./firesim-staging
}

show_usage()
{
    echo "Setup Pre-built Vortex Toolchain"
    echo "Usage: $0 [--pocl] [--chipstar] [--mesa] [--verilator] [--riscv32] [--riscv64] [--llvm] [--libcrt32] [--libcrt64] [--libc32] [--libc64] [--sv2v] [--yosys] [--sta] [--gem5] [--firesim] [--all] [-h|--help]"
}

while [ "$1" != "" ]; do
    case $1 in
        --pocl ) pocl
                ;;
        --chipstar ) chipstar
                ;;
        --mesa ) mesa
                ;;
        --verilator ) verilator
                ;;
        --riscv32 ) riscv32
                ;;
        --riscv64 ) riscv64
                ;;
        --llvm ) llvm
                ;;
        --libcrt32 ) libcrt32
                ;;
        --libcrt64 ) libcrt64
                ;;
        --libc32 ) libc32
                ;;
        --libc64 ) libc64
                ;;
        --sv2v ) sv2v
                ;;
        --yosys ) yosys
                ;;
        --sta ) sta
                ;;
        --gem5 ) gem5
                ;;
        --firesim ) firesim
                ;;
        --all ) pocl
                chipstar
                verilator
                riscv32
                riscv64
                llvm
                libcrt32
                libcrt64
                libc32
                libc64
                sv2v
                yosys
                sta
                mesa
                gem5
                ;;
        -h | --help ) show_usage
                exit
                ;;
        * ) show_usage
                exit 1
    esac
    shift
done
