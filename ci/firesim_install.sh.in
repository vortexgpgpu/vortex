#
# FireSim install for FPGA-accelerated simulation — see
# docs/designs/firesim_integration.md for the design and operator manual.
#
# Unlike POCL, Mesa or chipStar there is no compile-and-install step: the
# Vortex flow stages its Chisel target into the checkout and elaborates there,
# so $TOOLDIR/firesim is a source tree rather than an install prefix.
#
# What costs time is the conda environment build-setup.sh resolves — a JVM,
# sbt and Scala for Golden Gate. Most users should take the prebuilt bundle
# instead:
#
#     ci/toolchain_install.sh --firesim
#
# and use this script only when working on FireSim itself.

set -e

TOOLDIR=${TOOLDIR:=@TOOLDIR@}
FIRESIM_REPO=${FIRESIM_REPO:=https://github.com/vortexgpgpu/firesim.git}
FIRESIM_REV=${FIRESIM_REV:=vortex_3.x}

FIRESIM_PREFIX=$TOOLDIR/firesim

# ----------------------------------------------------------------------
# 1. Build dependencies
# ----------------------------------------------------------------------
DEBIAN_FRONTEND=noninteractive sudo apt install -y \
    build-essential git curl ca-certificates

# ----------------------------------------------------------------------
# 2. Fetch
# ----------------------------------------------------------------------
if [ ! -d "$FIRESIM_PREFIX/.git" ]; then
    mkdir -p "$TOOLDIR"
    rm -rf "$FIRESIM_PREFIX"
    git clone --branch "$FIRESIM_REV" --recursive \
        "$FIRESIM_REPO" "$FIRESIM_PREFIX"
else
    git -C "$FIRESIM_PREFIX" fetch origin "$FIRESIM_REV"
    git -C "$FIRESIM_PREFIX" checkout "$FIRESIM_REV"
    git -C "$FIRESIM_PREFIX" submodule update --init --recursive
fi

# ----------------------------------------------------------------------
# 3. Conda environment
# ----------------------------------------------------------------------
# build-setup.sh resolves .conda-env in place. --skip-validate drops the
# AWS/manager checks, which a local FPGA flow does not use.
#
# The environment is NOT relocatable: conda records its own prefix in every
# script shebang and in package metadata, so moving $TOOLDIR/firesim after
# this point breaks activation with an error naming the old path. Install it
# where it will live, or re-pack it with ci/toolchain_prebuilt.sh --firesim.
if [ ! -d "$FIRESIM_PREFIX/.conda-env" ]; then
    ( cd "$FIRESIM_PREFIX" && ./build-setup.sh --skip-validate )
fi

# ----------------------------------------------------------------------
# 4. Environment
# ----------------------------------------------------------------------
# config.mk exposes the checkout as $(FIRESIM_PATH); nothing else needs a
# global export. Activate the environment only when elaborating:
#
#     source $TOOLDIR/firesim/.conda-env/bin/activate
#
# `bin/activate` rather than `conda activate` — see docs/building_toolchain.md.

# GitHub Actions: propagate to subsequent steps.
if [ -n "$GITHUB_ENV" ]; then
    echo "FIRESIM_PATH=$FIRESIM_PREFIX" >> "$GITHUB_ENV"
fi

echo ""
echo "firesim $FIRESIM_REV installed at $FIRESIM_PREFIX"
echo "  sources:  $FIRESIM_PREFIX/sim"
echo "  conda:    $FIRESIM_PREFIX/.conda-env"
echo "  activate: source $FIRESIM_PREFIX/.conda-env/bin/activate"
echo "  verify:   make -C hw/syn/firesim check-firesim"
