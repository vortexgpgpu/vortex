#version 450
#extension GL_EXT_shader_image_load_formatted : require
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, r32ui) uniform uimage2D img;
layout(set = 0, binding = 1) buffer Out { uvec4 o[]; };
layout(set = 0, binding = 2, r32ui) uniform readonly uimage2DMS msimg;
layout(set = 0, binding = 3) uniform readonly uimage2D nf;
void main()
{
   o[0] = uvec4(imageSize(img), 7u, 7u);
   o[1] = imageLoad(img, ivec2(1, 1));
   imageStore(img, ivec2(2, 2), uvec4(77u));
   o[2] = uvec4(uint(imageSamples(msimg)), 7u, 7u, 7u);
   o[3] = imageLoad(nf, ivec2(1, 1));
}
