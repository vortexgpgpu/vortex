#version 450
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
#extension GL_EXT_buffer_reference : require
/*
 * Copyright © 2026  Vortex GPGPU
 * SPDX-License-Identifier: MIT
 *
 * 64-bit integer atomics in every address space the device reaches: a storage
 * buffer, workgroup shared memory and a buffer device address. Every target is
 * contended by the lanes of one warp, by the warps of a workgroup and, outside
 * shared memory, by every workgroup.
 *
 * Operands are chosen so that each half of a 64-bit word matters: the adds
 * carry across the 32-bit boundary, the min/max operands differ in the high
 * word and, between pairs of lanes, only in the low word, with the sign bit
 * mixed in, and every bit operand sets a bit in each half. A device that ran
 * these as 32-bit atomics, or tore a word, ends with the wrong value.
 */

layout(local_size_x_id = 0) in;

#define TOTAL    256u
#define NADD     2u
#define NSLOT    16u
#define NGRP_MAX 64u

layout(std430, binding = 0) buffer Acc {
   uint64_t add[NADD];
   uint64_t band;
   uint64_t bor;
   uint64_t bxor;
   int64_t  smin;
   int64_t  smax;
   uint64_t umin;
   uint64_t umax;
   uint64_t xchg;
   uint64_t cas;
   uint64_t slot[NSLOT];
   uint64_t ret_add[TOTAL];
   uint64_t ret_or[TOTAL];
   uint64_t ret_and[TOTAL];
   int64_t  ret_smin[TOTAL];
   int64_t  ret_smax[TOTAL];
   uint64_t ret_umin[TOTAL];
   uint64_t ret_umax[TOTAL];
   uint64_t ret_xchg[TOTAL];
   uint64_t ret_slot[TOTAL];
   uint64_t ret_sadd[TOTAL];
   uint64_t ret_sxchg[TOTAL];
   uint64_t ret_badd[TOTAL];
   int64_t  ret_bsmax[TOTAL];
   uint64_t grp[NGRP_MAX * 8u];
   uint64_t op[TOTAL];
};

layout(buffer_reference, std430, buffer_reference_align = 8) buffer Remote {
   uint64_t add;
   int64_t  smax;
   uint64_t cas;
   uint64_t umin;
};

layout(push_constant) uniform Push {
   Remote remote;
} pc;

shared uint64_t s_add;
shared uint64_t s_and;
shared uint64_t s_or;
shared uint64_t s_xor;
shared int64_t  s_smin;
shared uint64_t s_umax;
shared uint64_t s_xchg;
shared uint64_t s_cas;

const uint64_t addend[NADD] = uint64_t[NADD](0x0000000100000001ul, 0x00000000fffffff1ul);

/* Adds `step` through a compare-and-swap loop; the retry carries on from the
 * word each failed swap returns. */
#define CAS_ADD(target, step)                                   \
   {                                                            \
      uint64_t seen = target;                                   \
      for (;;) {                                                \
         uint64_t prev = atomicCompSwap(target, seen, seen + step); \
         if (prev == seen)                                      \
            break;                                              \
         seen = prev;                                           \
      }                                                         \
   }

void main()
{
   uint i = gl_GlobalInvocationID.x;
   uint l = gl_LocalInvocationIndex;
   uint64_t v = op[i];
   uint64_t bit = (1ul << (i % 32u)) | (1ul << (32u + (i * 7u + 3u) % 32u));

   if (l == 0u) {
      s_add  = 0xfffffff0fffffff0ul;
      s_and  = ~0ul;
      s_or   = 0ul;
      s_xor  = 0x0123456789abcdeful;
      s_smin = 0x7fffffffffffffffl;
      s_umax = 0ul;
      s_xchg = 0x5a5a5a5aa5a5a5a5ul;
      s_cas  = 0x00000000ffffffe0ul;
   }
   barrier();

   /* --- storage buffer --- */
   ret_add[i]  = atomicAdd(add[i % NADD], addend[i % NADD]);
   ret_and[i]  = atomicAnd(band, ~bit);
   ret_or[i]   = atomicOr(bor, bit);
   atomicXor(bxor, v);
   ret_smin[i] = atomicMin(smin, int64_t(v));
   ret_smax[i] = atomicMax(smax, int64_t(v));
   ret_umin[i] = atomicMin(umin, v);
   ret_umax[i] = atomicMax(umax, v);
   ret_xchg[i] = atomicExchange(xchg, uint64_t(i + 1u) * 0x0000000100000001ul);
   CAS_ADD(cas, 0x0000000100000001ul)
   ret_slot[i] = atomicCompSwap(slot[i % NSLOT], 0ul, uint64_t(i + 1u) * 0x0000000100000001ul);

   /* --- shared memory --- */
   ret_sadd[i]  = atomicAdd(s_add, 0x0000000100000003ul);
   atomicAnd(s_and, ~bit);
   atomicOr(s_or, bit);
   atomicXor(s_xor, v);
   atomicMin(s_smin, int64_t(v));
   atomicMax(s_umax, v);
   ret_sxchg[i] = atomicExchange(s_xchg, uint64_t(i + 1u) * 0x0000000100000001ul);
   CAS_ADD(s_cas, 1ul)

   /* --- buffer device address --- */
   ret_badd[i]  = atomicAdd(pc.remote.add, 0x00000000fffffffful);
   ret_bsmax[i] = atomicMax(pc.remote.smax, int64_t(v));
   atomicMin(pc.remote.umin, v);
   CAS_ADD(pc.remote.cas, 0x0000000100000001ul)

   barrier();
   if (l == 0u) {
      uint b = gl_WorkGroupID.x * 8u;
      grp[b + 0u] = s_add;
      grp[b + 1u] = s_and;
      grp[b + 2u] = s_or;
      grp[b + 3u] = s_xor;
      grp[b + 4u] = uint64_t(s_smin);
      grp[b + 5u] = s_umax;
      grp[b + 6u] = s_xchg;
      grp[b + 7u] = s_cas;
   }
}
