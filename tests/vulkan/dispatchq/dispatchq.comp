 *
 * Two things a compute shader can ask about its own dispatch, neither of which
 * the shader can know at compile time and neither of which anything else in
 * this suite reads:
 *
 *   gl_NumWorkGroups   the grid the dispatch was issued with, read from a CSR
 *   data.length()      the element count the descriptor was bound with, read
 *                      out of the descriptor's own size field
 *
 * Both are carried in one word, in separate decimal places, so a wrong answer
 * says which of the two moved rather than just that the word is wrong. The
 * grid is the low part because it is the smaller and more bounded of the two.
 */
#version 450

layout(local_size_x_id = 0) in;

layout(std430, binding = 0) buffer Buf {
   uint data[];
};

void main()
{
   uint i = gl_GlobalInvocationID.x;
   data[i] = gl_NumWorkGroups.x + 1000u * uint(data.length());
}
