 *
 * Counts each workgroup it runs as and records the grid it was dispatched
 * with, so a missing, extra or misplaced workgroup and a wrong grid are each
 * visible.
 */
#version 450

layout(local_size_x = 4) in;

layout(std430, binding = 1) buffer Hits {
   uint hits[];
};

layout(std430, binding = 2) buffer Meta {
   uint meta[];
};

void main()
{
   if (gl_LocalInvocationIndex != 0u) {
      return;
   }
   uint wid = (gl_WorkGroupID.z * gl_NumWorkGroups.y + gl_WorkGroupID.y)
            * gl_NumWorkGroups.x + gl_WorkGroupID.x;
   hits[wid] += 1u;
   if (wid == 0u) {
      meta[0] = gl_NumWorkGroups.x;
      meta[1] = gl_NumWorkGroups.y;
      meta[2] = gl_NumWorkGroups.z;
      meta[3] += 1u;
   }
}
