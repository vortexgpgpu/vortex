 *
 * Reports one hit per box, at a distance and hit kind derived from the
 * geometry and primitive, with an attribute pair the closest-hit reads. */
#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require
#include "rtpipe.glsl"

hitAttributeEXT vec2 attr;

void main()
{
   attr = vec2(float(gl_PrimitiveID) + 0.5, gl_ObjectRayOriginEXT.x);
   float t = gl_WorldRayOriginEXT.z - 0.25 - 0.5 * float(gl_GeometryIndexEXT);
   reportIntersectionEXT(t, 7u + gl_PrimitiveID);
}
