 *
 * Calls the other callable from inside a callable for every fourth answer. */
#version 460
#extension GL_EXT_ray_tracing : require

layout(location = 1) callableDataInEXT uint call;
layout(location = 2) callableDataEXT uint inner;
layout(shaderRecordEXT, std430) buffer Sbt { uint sbt_data; };

void main()
{
   call = call * 3u + sbt_data;
   if ((call & 3u) == 0u) {
      inner = call;
      executeCallableEXT(1, 2);
      call = inner + 7u;
   }
}
