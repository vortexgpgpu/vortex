#version 450

/* Every texel of a sampled image, read with texelFetch and packed as it is
 * stored. */
layout(local_size_x = 16) in;

layout(binding = 0) uniform sampler2D tex;
layout(std430, binding = 1) buffer Out { uint px[]; };
layout(push_constant) uniform Push { uint w, h; };

void main()
{
   uint i = gl_GlobalInvocationID.x;
   if (i >= w * h)
      return;
   px[i] = packUnorm4x8(texelFetch(tex, ivec2(i % w, i / w), 0));
}
