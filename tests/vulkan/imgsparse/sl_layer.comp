 *
 * imageLoad + imageStore of every texel of a 2D view of one layer of a sparse
 * array: each texel becomes 2v + 1.
 */

layout(local_size_x = 4, local_size_y = 4) in;

layout(binding = 0, r32ui) uniform uimage2D img;

void main()
{
   ivec2 c = ivec2(gl_GlobalInvocationID.xy);
   uint v = imageLoad(img, c).x;
   imageStore(img, c, uvec4(v * 2u + 1u, 0u, 0u, 0u));
}
