 * SPDX-License-Identifier: MIT
 *
 * A store through an image declared without a format: the texel encode has to
 * come from the view, at run time. Four distinct channels, one negative.
 */

layout(local_size_x = 4, local_size_y = 4) in;

layout(binding = 0) writeonly uniform image2D img;

void main()
{
   imageStore(img, ivec2(gl_GlobalInvocationID.xy), vec4(1.0, -0.6, 0.3, 0.8));
}
